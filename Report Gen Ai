<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PAC-1: Hospital Operations AI</title>
    <style>
        :root {
            --bg-color: #050914;
            --panel-bg: #0b1221;
            --accent-cyan: #00f3ff;
            --accent-blue: #0066ff;
            --text-main: #e2e8f0;
            --text-muted: #64748b;
            --border-glow: 0 0 10px rgba(0, 243, 255, 0.2);
            --font-mono: 'Courier New', Courier, monospace;
            --font-sans: system-ui, -apple-system, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-sans);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .header {
            grid-column: 1 / -1;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-bottom: 2px solid var(--accent-blue);
            padding-bottom: 15px;
            margin-bottom: 10px;
        }

        h1 {
            font-family: var(--font-mono);
            font-size: 1.8rem;
            color: var(--accent-cyan);
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.4);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .sys-status {
            font-size: 0.85rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pulse {
            width: 8px;
            height: 8px;
            background-color: var(--accent-cyan);
            border-radius: 50%;
            animation: blink 1.5s infinite;
        }

        .panel {
            background: var(--panel-bg);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 8px;
            padding: 20px;
            box-shadow: var(--border-glow);
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .section-title {
            font-family: var(--font-mono);
            color: var(--accent-blue);
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .input-group {
            display: flex;
            gap: 10px;
        }

        input[type="date"], select, textarea {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(0, 243, 255, 0.2);
            color: var(--accent-cyan);
            padding: 10px;
            border-radius: 4px;
            font-family: var(--font-mono);
            outline: none;
            transition: 0.3s;
            width: 100%;
        }

        input[type="date"]:focus, select:focus, textarea:focus {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 5px rgba(0, 243, 255, 0.5);
        }

        .shortcuts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 10px;
        }

        button {
            background: transparent;
            border: 1px solid var(--accent-blue);
            color: var(--accent-cyan);
            padding: 10px;
            border-radius: 4px;
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        button:hover {
            background: rgba(0, 102, 255, 0.2);
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
            transform: translateY(-2px);
        }

        .btn-action {
            background: rgba(0, 243, 255, 0.1);
            border-color: var(--accent-cyan);
            font-weight: bold;
            font-size: 1rem;
            padding: 15px;
            margin-top: 10px;
        }

        .btn-action:hover {
            background: var(--accent-cyan);
            color: #000;
        }

        textarea {
            resize: vertical;
            min-height: 120px;
            font-size: 0.95rem;
            line-height: 1.5;
            color: var(--text-main);
        }

        .output-textarea {
            flex-grow: 1;
            min-height: 300px;
            background: rgba(0, 0, 0, 0.8);
            border-left: 3px solid var(--accent-cyan);
            font-family: var(--font-mono);
        }

        .stats-container {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
            background: rgba(0, 0, 0, 0.4);
            padding: 15px;
            border-radius: 6px;
            border: 1px solid rgba(0, 243, 255, 0.1);
        }

        .stat-box {
            flex: 1;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--accent-cyan);
            font-family: var(--font-mono);
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .progress-bar {
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            margin-top: 8px;
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--accent-cyan);
            width: 0%;
            transition: width 0.8s ease-out;
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        @keyframes blink {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }

        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
            }
            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <header class="header">
        <h1>PAC-1 CMD CENTER</h1>
        <div class="sys-status">
            <div class="pulse"></div>
            SYSTEM ONLINE // OFFLINE MODE ACTIVE
        </div>
    </header>

    <!-- LEFT PANEL: INPUT & CONTROLS -->
    <div class="panel">
        <div class="section-title">Initialize Shift Data</div>
        <div class="input-group">
            <input type="date" id="reportDate">
            <select id="shiftSelect">
                <option value="Morning Shift">Morning Shift (0700-1500)</option>
                <option value="Evening Shift">Evening Shift (1500-2300)</option>
                <option value="Night Shift">Night Shift (2300-0700)</option>
            </select>
        </div>

        <div class="section-title" style="margin-top: 10px;">Command Shortcuts</div>
        <div class="shortcuts-grid">
            <button onclick="addTag('patient handling')">Patient</button>
            <button onclick="addTag('calls')">Calls</button>
            <button onclick="addTag('billing')">Billing</button>
            <button onclick="addTag('registration')">Registration</button>
            <button onclick="addTag('learning')">Learning</button>
        </div>

        <div class="section-title" style="margin-top: 10px;">Raw Input Stream</div>
        <textarea id="rawInput" placeholder="Enter keywords separated by commas (e.g., patient handling, calls, filing...)"></textarea>

        <button class="btn-action" onclick="generateReport()">Compile Report</button>
    </div>

    <!-- RIGHT PANEL: OUTPUT & STATS -->
    <div class="panel">
        <div class="section-title">System Telemetry</div>
        <div class="stats-container">
            <div class="stat-box">
                <div class="stat-value" id="taskCount">0</div>
                <div class="stat-label">Tasks Logged</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="perfScore">0%</div>
                <div class="stat-label">Productivity Index</div>
                <div class="progress-bar">
                    <div class="progress-fill" id="scoreBar"></div>
                </div>
            </div>
        </div>

        <div class="section-title">Compiled Output Stream</div>
        <textarea id="outputDisplay" class="output-textarea" readonly placeholder="Awaiting execution..."></textarea>
        
        <button onclick="copyReport()">Copy to Clipboard</button>
    </div>
</div>

<script>
    // Initialize Date to Today
    document.getElementById('reportDate').valueAsDate = new Date();

    // AI Knowledge Base
    const intelligenceDB = {
        "patient handling": {
            expansion: "Assisted patients with comprehensive check-in procedures, addressed inquiries proactively, and ensured an optimized flow within the waiting area.",
            learning: "Enhanced de-escalation techniques and interpersonal communication during high-traffic patient intake periods."
        },
        "calls": {
            expansion: "Managed the multiline telecommunications system, triaged incoming calls based on medical urgency, and routed communications accurately.",
            learning: "Improved multi-tasking and operational efficiency in call routing and emergency prioritization."
        },
        "billing": {
            expansion: "Processed patient copayments, verified insurance eligibility across multiple portals, and reconciled end-of-shift financial ledgers.",
            learning: "Refined accuracy in insurance verification workflows and secure payment processing compliance."
        },
        "registration": {
            expansion: "Executed demographic and clinical data entry for new admissions with stringent adherence to HIPAA privacy standards.",
            learning: "Streamlined the digital intake process to proactively minimize overall patient wait times."
        },
        "learning": {
            expansion: "Engaged in cross-training modules to elevate operational competencies and maintain high-tier patient service standards.",
            learning: "Acquired new procedural knowledge to adapt to evolving hospital administrative frameworks."
        }
    };

    function addTag(tag) {
        const inputField = document.getElementById('rawInput');
        let currentVal = inputField.value.trim();
        if (currentVal.length > 0 && !currentVal.endsWith(',')) {
            inputField.value = currentVal + ', ' + tag;
        } else {
            inputField.value = currentVal + tag;
        }
        inputField.focus();
    }

    function generateReport() {
        const rawText = document.getElementById('rawInput').value.toLowerCase();
        const dateInput = document.getElementById('reportDate').value;
        const shiftInput = document.getElementById('shiftSelect').value;

        if (!rawText) {
            alert("SYSTEM HALT: Input stream empty. Please provide keywords.");
            return;
        }

        // Format Date
        let dateObj = new Date(dateInput);
        // Correct timezone offset for display
        dateObj.setMinutes(dateObj.getMinutes() + dateObj.getTimezoneOffset());
        const formattedDate = dateObj.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        // Parsing Logic
        let keywords = rawText.split(/[\n,]+/).map(k => k.trim()).filter(k => k.length > 0);
        
        let reportSentences = [];
        let learningPoints = [];
        let tasksFound = 0;

        keywords.forEach(kw => {
            let matched = false;
            
            // Exact or partial match in DB
            for (const [key, data] of Object.entries(intelligenceDB)) {
                if (kw.includes(key) || key.includes(kw)) {
                    if (!reportSentences.includes(data.expansion)) {
                        reportSentences.push(data.expansion);
                        learningPoints.push(data.learning);
                        tasksFound++;
                    }
                    matched = true;
                    break;
                }
            }

            // Fallback for unknown keywords
            if (!matched) {
                let capitalized = kw.charAt(0).toUpperCase() + kw.slice(1);
                reportSentences.push(`Successfully facilitated administrative protocols regarding: ${capitalized}.`);
                learningPoints.push(`Identified strategic optimization opportunities within ${kw} workflows.`);
                tasksFound++;
            }
        });

        // Construct Output Text
        let output = `Today's Report: ${formattedDate}\nShift: ${shiftInput}\n\n`;
        
        reportSentences.forEach(sentence => {
            output += `*. ${sentence}\n`;
        });

        output += `\nKey Learnings & Improvements:\n\n`;
        
        learningPoints.forEach(learning => {
            output += `- ${learning}\n`;
        });

        document.getElementById('outputDisplay').value = output;

        // Update Telemetry
        document.getElementById('taskCount').innerText = tasksFound;
        
        // Calculate score (Base + bonus per task up to 100)
        let score = Math.min(40 + (tasksFound * 15), 100);
        
        // Animate score
        let currentScore = 0;
        let scoreInterval = setInterval(() => {
            currentScore += 2;
            if (currentScore >= score) {
                currentScore = score;
                clearInterval(scoreInterval);
            }
            document.getElementById('perfScore').innerText = `${currentScore}%`;
            document.getElementById('scoreBar').style.width = `${currentScore}%`;
        }, 15);
    }

    function copyReport() {
        const outputField = document.getElementById('outputDisplay');
        if (!outputField.value) {
            alert("No data to copy.");
            return;
        }
        outputField.select();
        document.execCommand('copy');
        
        // Visual feedback
        const btn = event.target;
        const originalText = btn.innerText;
        btn.innerText = "COPIED TO CLIPBOARD!";
        btn.style.background = "var(--accent-cyan)";
        btn.style.color = "#000";
        
        setTimeout(() => {
            btn.innerText = originalText;
            btn.style.background = "transparent";
            btn.style.color = "var(--accent-cyan)";
        }, 2000);
    }
</script>
</body>
</html>
